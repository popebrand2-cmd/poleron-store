DATABASE_URL="file:./dev.db"

# Cambia esto antes de publicar la tienda — protege /admin.
ADMIN_PASSWORD="cambia-esta-clave"

# Mercado Pago — deja vacío para correr en "modo de prueba" (sin cobrar).
# Credenciales: https://www.mercadopago.cl/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Instagram — publicaciones que se actualizan solas en la portada (cuenta Business/Creator).
# Token de larga duración de la API de Instagram (developers.facebook.com → tu app → Instagram → Generar token).
# Déjalo vacío para usar solo las publicaciones que subas a mano.
INSTAGRAM_ACCESS_TOKEN=""

# Meta Pixel — deja vacío para no cargar nada (sin costo ni tracking).
# ID: business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=""

# Solo en producción: carpeta del volumen persistente para las imágenes subidas.
# UPLOADS_DIR="/data/uploads"
