generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A sellable product, e.g. "Poleron Oversize Classic"
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  basePrice   Int // CLP, no decimals
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  colors    ProductColor[]
  sizes     ProductSize[]
  materials ProductMaterial[]
  orderItems OrderItem[]
}

// A color option for a product, with its own base mockup photos + print zones
model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String // e.g. "Negro"
  hex     String // e.g. "#111111"
  sortOrder Int   @default(0)

  views ProductView[]
}

// One photographed angle of a color (front, back, sleeve-left, sleeve-right...)
model ProductView {
  id             String       @id @default(cuid())
  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  label     String // "Frente" | "Espalda" | "Manga izquierda" | "Manga derecha"
  imageUrl  String
  sortOrder Int    @default(0)

  // Print zone: a rectangle (in % of image width/height, 0-100) marking the
  // MAXIMUM area the customer's design can occupy, plus rotation allowance.
  // The customer can shrink this zone (never enlarge it) on the product
  // page; maxWidthCm/maxHeightCm are the real-world size of that zone at
  // its full (100%) size, used to show live cm measurements while resizing.
  zoneXPct      Float
  zoneYPct      Float
  zoneWidthPct  Float
  zoneHeightPct Float
  maxWidthCm    Float   @default(20)
  maxHeightCm   Float   @default(20)
  allowRotate   Boolean @default(true)
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label      String // "S" | "M" | "L" | "XL"
  sortOrder  Int    @default(0)
  priceDelta Int    @default(0) // CLP added on top of basePrice

  // Real garment measurements (cm) for this size, from the supplier's size
  // chart. Optional — when missing, the print zone just uses the view's
  // maxWidthCm/maxHeightCm as-is with no scaling. When present, the print
  // zone auto-scales relative to the "M" size (see lib/size-scale.ts),
  // since maxWidthCm/maxHeightCm on ProductView are set against a size-M
  // garment.
  chestCm  Float?
  lengthCm Float?
  sleeveCm Float?
}

// Print technique offered for a product, e.g. "DTF", "Bordado", "Vinilo".
model ProductMaterial {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label      String // "DTF"
  sortOrder  Int    @default(0)
  priceDelta Int    @default(0) // CLP added on top of basePrice
}

// SQLite has no native enum type, so status is a plain string constrained
// in application code to: PENDING_PAYMENT | PAID | IN_PRODUCTION | SHIPPED | CANCELLED
model Order {
  id            String   @id @default(cuid())
  status        String   @default("PENDING_PAYMENT")
  customerName  String
  customerEmail String
  customerPhone String   @default("")
  shippingAddr  String   @default("")
  // "PICKUP" | "DELIVERY"
  shippingMethod String  @default("DELIVERY")
  // Chile comuna name, only set for DELIVERY — see ShippingComunaRate.
  shippingComuna String  @default("")
  shippingCost   Int     @default(0) // CLP, snapshot of the rate at purchase time
  totalAmount   Int // CLP, items + shippingCost
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

// Admin-editable delivery price per Chilean comuna (346 of them — comuna
// names are unique across Chile, no region-scoping needed for lookup).
// Pickup is handled separately (see StoreSettings) since it's a single
// fixed location, not priced per comuna.
model ShippingComunaRate {
  id        String @id @default(cuid())
  region    String // for grouping/display in the admin UI
  comuna    String @unique
  priceCLP  Int    @default(0)
  sortOrder Int    @default(0)
}

// Single-row settings table (always id "singleton") for store-wide config
// that isn't tied to a specific product — currently just pickup info.
model StoreSettings {
  id             String  @id @default("singleton")
  pickupEnabled  Boolean @default(true)
  pickupAddress  String  @default("")
  pickupHours    String  @default("")
  // Home page hero photo (customer-facing lifestyle photo) — empty until
  // the admin uploads one; the hero renders a styled placeholder until then.
  heroImageUrl   String  @default("")
  // Hero text content, admin-editable from /admin/portada. heroHeadline
  // uses literal "\n" to mark line breaks; the LAST line is always
  // rendered in the brand's neon accent color.
  heroEyebrow    String  @default("POPE · Personalización 100% real")
  heroHeadline   String  @default("Diseña\ntu propia\nesencia.")
  heroSubtext    String  @default("Sube tu diseño, personalízalo sobre la prenda real y mira el resultado antes de comprar. Sin catálogos genéricos — cada pieza sale exactamente como la imaginaste.")
  heroCta        String  @default("Personaliza aquí")
  // "left" | "right" — which side the hero photo sits on (text takes the other side).
  heroImageAlign String  @default("right")
  // Focal point (0-100, % from left/top) and zoom (1 = no zoom, 2 = 2x) for
  // the full-bleed hero photo, so the admin can re-frame it without
  // re-cropping the source file.
  heroImagePosX  Float   @default(50)
  heroImagePosY  Float   @default(50)
  heroImageZoom  Float   @default(1)
  // Brand accent color (hex), applied site-wide via a CSS variable in place
  // of the old hardcoded Tailwind "neon" color. Empty = use the code default.
  accentColor    String  @default("")
}

// Freeform key/value store for small homepage text snippets edited inline
// from the site itself (section eyebrows/headings/subtexts that aren't
// worth a dedicated StoreSettings column). Missing keys fall back to the
// hardcoded defaults in src/lib/site-content.ts.
model SiteText {
  key   String @id
  value String
}

// One item in a repeatable homepage list (the "values" bullets under the
// hero, the "how it works" steps, the trust badges, or the FAQ). `section`
// picks which list it belongs to and which fields are actually used:
//   values      -> icon, text
//   howItWorks  -> icon, title, text
//   trustBadges -> icon, title, text
//   faq         -> title (question), text (answer)
// Editable inline (add/remove/reorder/edit) from the homepage edit mode.
// One page view, logged client-side (see VisitTracker.tsx) so it only
// counts real browser loads. visitorId is a random id stored in a
// long-lived first-party cookie — no personal data — just enough to tell
// pageviews and unique visitors apart in /admin/estadisticas.
model Visit {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  createdAt DateTime @default(now())
}

model ContentItem {
  id        String   @id @default(cuid())
  section   String
  icon      String   @default("")
  title     String   @default("")
  text      String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// A themed group of ready-made designs the customer can pick instead of
// uploading their own artwork (e.g. "Urbano", "Navidad"). Admin-managed.
model DesignCollection {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Section shown as a tab on the homepage carousel (e.g. "Reguetón", "Anime"); free text, empty = "Otros".
  category  String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  designs PresetDesign[]
}

// One ready-made design image within a collection. `placement` decides how
// it behaves in the personalizer: "FRONT" designs let the customer choose
// left/center/right chest; "BACK" designs always apply at a fixed size
// centered below the hood, with no position choice.
model PresetDesign {
  id           String           @id @default(cuid())
  collectionId String
  collection   DesignCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  name      String
  imageUrl  String
  placement String // "FRONT" | "BACK"
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  colorName    String
  sizeLabel    String
  materialLabel String @default("")
  quantity     Int    @default(1)
  unitPrice  Int // CLP, snapshot at purchase time

  // Per-view design placement snapshot, e.g.
  // { "Frente": { designUrl, xPct, yPct, widthPct, rotationDeg }, "Espalda": {...} }
  designPlacement String
  previewImageUrl String // rendered mockup thumbnail shown in the cart/order
}

// Team member who logs into /admin with their own email + password. The owner is not stored here (she uses ADMIN_PASSWORD). role PARTNER = every section; EMPLOYEE = only the sections listed in `permissions` (comma-separated keys from SECTIONS in lib/admin-auth.ts).

model AdminUser {

  id           String   @id @default(cuid())

  name         String

  email        String   @unique

  passwordHash String

  role         String   @default("EMPLOYEE")

  permissions  String   @default("pedidos")

  active       Boolean  @default(true)

  createdAt    DateTime @default(now())

}
